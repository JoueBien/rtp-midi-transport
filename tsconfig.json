{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "target": "es2020",
    "moduleResolution": "nodenext",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "noImplicitOverride": true
  },
  "lib": ["es2020"],
  "include": ["src/**/*.ts", "tests/**/*.test.ts"]
}
