{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "target": "es6",
    "moduleResolution": "nodenext",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["vitest/globals", "node"],
    "skipLibCheck": true
  },
  "lib": ["es2015"],
  "include": ["src/**/*.ts", "tests/**/*.test.ts"]
}
